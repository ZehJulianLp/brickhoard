SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///brickshelf.db
REBRICKABLE_API_KEY=
CREDENTIAL_ENCRYPTION_KEY=
FLASK_ENV=development

# E-Mail-Versand
MAIL_SERVER=mail.julianverse.de
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=brickhoard@julianverse.de
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=BrickHoard <brickhoard@julianverse.de>
MAIL_TIMEOUT=10
MAIL_SUPPRESS_SEND=false

# In Bestätigungs-, Reset- und Social-Mails werden zunächst beide Adressen angeboten.
EMAIL_LINK_BASE_URLS=http://localhost:5000,https://brickhoard.julianverse.de
PUBLIC_BASE_URL=https://brickhoard.julianverse.de

# Rechtliche Angaben; Anschriftszeilen mit | trennen.
LEGAL_OPERATOR_NAME=Vorname Nachname
LEGAL_POSTAL_ADDRESS=Straße Hausnummer|PLZ Ort|Deutschland
LEGAL_CONTACT_EMAIL=brickhoard@julianverse.de
PRIVACY_LAST_UPDATED=13. August 2026
EMAIL_CONFIRM_TOKEN_MAX_AGE=86400
PASSWORD_RESET_TOKEN_MAX_AGE=3600
MAIL_RESEND_COOLDOWN=60
